# ============================================
# ORCHESTRATION SERVICE - Environment Template
# Copy this file to .env and fill in your values
# ============================================

# Application
NODE_ENV=development
PORT=3002
LOG_LEVEL=info

# Supabase Database Configuration
# Get these from: https://app.supabase.com/project/[PROJECT_ID]/settings/database
SUPABASE_DB_HOST=your-project.supabase.co
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_database_password
SUPABASE_DB_NAME=postgres
SUPABASE_DB_SSL_CERT=

# Supabase API Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Auth Service Configuration
AUTH_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3003

# JWT Public Key (must match auth-service public key)
JWT_PUBLIC_KEY=base64_encoded_public_key

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# CORS Configuration
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ============================================
# ACCESS LINK CONFIGURATION
# ============================================
ACCESS_LINK_SECRET=your-long-random-secret
ACCESS_LINK_BASE_URL=http://localhost:3000/otppage
ARRIVAL_FRONTEND_OTP_URL=http://localhost:3000/otppage
FRONTEND_WEB_URL=http://localhost:3000
ARRIVAL_FRONTEND_OTP_PATH=/otppage
ACCESS_LINK_TTL_DAYS=14

# ============================================
# PRICING ENGINE CONFIGURATION
# ============================================
PRICING_DEFAULT_CURRENCY=LKR
PRICING_TAX_RATE=0.08
VOLUMETRIC_DIVISOR=5000
DEFAULT_ORIGIN_POSTCODE=10000
CUTOFF_WINDOW_MINUTES=5
JOB_WORKER_INTERVAL_MS=30000
JOB_WORKER_BATCH=20
